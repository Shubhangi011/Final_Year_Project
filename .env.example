# GEMINI_API_KEY: Optional external AI key for enhanced generative profile & job descriptions.
# AI Studio automatically injects this at runtime from user secrets.
# Core matching, reputation, wage, fraud, and skill-gap algorithms run locally in Python/Server without requiring a paid key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# MONGODB_URI: MongoDB Community Server or MongoDB Atlas connection string.
# Use 127.0.0.1 (IPv4) so local MongoDB Community Server & MongoDB Compass connect reliably on Windows/macOS/Linux.
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB_NAME="kaushalsetu"

# JWT_SECRET: Secret key used to sign and verify role-based JWT access tokens.
JWT_SECRET="kaushalsetu-dev-jwt-secret-change-in-production"
